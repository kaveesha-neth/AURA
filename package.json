{
  "name": "aura-music-player",
  "version": "2.4.0",
  "description": "Aura - Local Music Player",
  "author": "Kaveesha Nethmal",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaveesha-neth/AURA.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "build-win": "node scripts/build-windows.cjs --publish never",
    "release-win": "node scripts/build-windows.cjs --publish always",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^27.0.0-alpha.8"
  },
  "build": {
    "appId": "com.aura.musicplayer",
    "productName": "Aura",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "kaveesha-neth",
      "repo": "AURA",
      "releaseType": "release",
      "tagNamePrefix": "v"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "youtube.js",
      "preload.js",
      "lyrics-overlay-preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "music-metadata": "^7.14.0"
  }
}
